{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "gc": true,
    "dedupe": true
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "realm": "zot",
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      }
    },
    "accessControl": {
      "repositories": {
        "**": {
          "anonymousPolicy": ["read"]
        }
      },
      "adminPolicy": {
        "users": ["admin"],
        "actions": ["read", "create", "update", "delete"]
      }
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true,
      "cve": {
        "updateInterval": "24h"
      }
    },
    "ui": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://index.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{"prefix": "**", "destination": "/docker.io"}]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{"prefix": "**", "destination": "/ghcr.io"}]
        },
        {
          "urls": ["https://gcr.io"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{"prefix": "**", "destination": "/gcr.io"}]
        },
        {
          "urls": ["https://quay.io"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{"prefix": "**", "destination": "/quay.io"}]
        },
        {
          "urls": ["https://mcr.microsoft.com"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{"prefix": "**", "destination": "/mcr.microsoft.com"}]
        },
        {
          "urls": ["https://registry.k8s.io"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{"prefix": "**", "destination": "/registry.k8s.io"}]
        },
        {
          "urls": ["https://oci.external-secrets.io"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{"prefix": "**", "destination": "/oci.external-secrets.io"}]
        }
      ]
    }
  }
}
